# cPanel / Apache settings for Muskoka Blackout Tinting
Options -Indexes
DirectoryIndex index.html

<Files "config.php">
  Require all denied
</Files>
<FilesMatch "^(README\.md|\.git.*|.*\.mjs)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# 3D models for the estimator
AddType model/gltf-binary .glb
AddType application/javascript .js

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript model/gltf-binary
</IfModule>

<IfModule mod_expires.c>
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Force HTTPS (uncomment once SSL/AutoSSL is active on the domain)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
